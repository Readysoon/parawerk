GRATIS_RUNDEN=1
GRATIS_NACHJUSTIEREN=2
IP_RUNDEN_PRO_TAG=3
TAGESBUDGET_USD=5
# eigener Zugang ohne Kontingente: einmal /?schluessel=… aufrufen (langer Zufallswert)
ADMIN_SCHLUESSEL=
