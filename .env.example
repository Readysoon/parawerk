# Bildgenerierung (Entwürfe) über Replicate, FLUX Fill Pro
REPLICATE_API_TOKEN=
# Konstruktion lesen und anpassen über die Claude-API
ANTHROPIC_API_KEY=
# optional
ANTHROPIC_MODEL=claude-sonnet-5-5
REPLICATE_MODEL=black-forest-labs/flux-fill-pro
REPLICATE_EDIT_MODEL=black-forest-labs/flux-kontext-pro
# Holz-Sortiment: DE (Baumarkt) oder US (Bauholz)
SORTIMENT=DE
# Kostendeckel. Ohne DATABASE_URL: SQLite im Temp-Ordner (lokal genug). Auf fly.io setzt "fly postgres attach" sie selbst.
